# =============================================================================
# AuraHomes Property Marketplace Portal — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to version control.

# =============================================================================
# 🚀 PRACTICAL ₹0 LAUNCH STACK CONFIGURATION
# =============================================================================

# ─── 1. App Configuration ───────────────────────────────────────────────────
APP_ENV=production
APP_NAME="AuraHomes"
APP_VERSION=1.0.0
DEBUG=false
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-32-chars

# ─── 2. Backend & CORS (Render / Railway / Fly.io Free Tier) ─────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# IMPORTANT: Set this to your exact production frontend URL only — never use * or localhost
BACKEND_CORS_ORIGINS=https://aurahomes.vercel.app,https://www.aurahomes.in

# ─── 3. Frontend (Vercel Free Tier) ──────────────────────────────────────────
# Set these in your Vercel Project Settings > Environment Variables:
NEXT_PUBLIC_API_URL=https://aurahomes-backend.onrender.com
NEXT_PUBLIC_SITE_URL=https://aurahomes.vercel.app
NEXT_PUBLIC_APP_NAME="AuraHomes"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXX

# ─── 4. Database (Supabase Free PostgreSQL Tier) ─────────────────────────────
# Grab this from Supabase Dashboard > Project Settings > Database > URI (Connection Pooling / Direct)
# Formats supported: postgresql+asyncpg://..., postgres://..., postgresql://...
DATABASE_URL=postgresql+asyncpg://postgres.your-project-id:your-supabase-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional Redis (Leave empty or set to Upstash Redis Free Tier: https://upstash.com)
REDIS_URL=redis://localhost:6379/0

# ─── 5. JWT Auth ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-strong-random-64-character-jwt-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# ─── 6. Free Image Storage (Cloudinary / Supabase Storage Free Tier) ────────
# Option A: Cloudinary Free Tier (25GB storage/bandwidth free)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Option B: Supabase Storage Free Tier (1GB free)
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-key
# SUPABASE_BUCKET=properties

# Option C: Local / Mock (Default for local development)
# STORAGE_PROVIDER=local

# ─── 7. Free Transactional Email (Gmail App Password / Resend / Brevo) ──────
# Option A: Gmail SMTP with 16-character App Password (500 emails/day free)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
EMAIL_FROM=noreply@aurahomes.in
EMAIL_FROM_NAME="AuraHomes"

# ─── 8. Payment Gateway: Razorpay (Pay-As-You-Go: ₹0 Monthly Fee) ────────────
# Only 2% fee deducted per successful customer transaction
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_live_secret_key
# Set in Razorpay Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── 9. WhatsApp Integration (Free Direct Click-To-Chat) ────────────────────
# The app uses free `https://wa.me/` direct chat links with 0 API costs!
# (Automated WhatsApp Cloud API is optional for later phase)
WHATSAPP_API_ENABLED=false

# ─── 10. SMS Gateway (Optional: Mock in dev, Fast2SMS / Twilio in prod) ─────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=AURAHM

# ─── 11. Rate Limiting ───────────────────────────────────────────────────────
RATE_LIMIT_OTP_PER_MINUTE=3
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=100

# ─── 12. Error Monitoring (Sentry — Free tier: 5k errors/month) ─────────────
# Get DSN from: https://sentry.io → New Project → FastAPI
SENTRY_DSN=https://your_key@o123456.ingest.sentry.io/your_project_id

# ─── 13. Security Hardening ─────────────────────────────────────────────────
# Set to 'true' to make the server refuse to start with insecure default secrets
INSECURE_DEFAULTS_FAIL_FAST=false
# Initial admin account password (set this BEFORE first deployment; ignored after admin is created)
ADMIN_INITIAL_PASSWORD=change-me-strong-admin-password

# ─── 14. Database Backup (cron example: 0 2 * * * /app/scripts/backup_db.sh backup) ─
BACKUP_DIR=/backups
KEEP_DAYS=7
